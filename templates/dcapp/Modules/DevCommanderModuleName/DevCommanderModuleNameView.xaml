<UserControl x:Class="DevCommanderModuleNameApp.Modules.DevCommanderModuleName.DevCommanderModuleNameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DevCommanderModuleNameApp.Modules.DevCommanderModuleName"
			 xmlns:controls="clr-namespace:Eyjo.DevCommander.WpfLibrary.Components;assembly=Eyjo.DevCommander.WpfLibrary"
             mc:Ignorable="d" 
			 d:DataContext="{d:DesignInstance Type=local:DevCommanderModuleNameViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="450" d:DesignWidth="800" d:Background="AliceBlue">
	<Grid>
		<Label Content="Sample String:" Margin="10,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
		<controls:CueTextBox Text="{Binding SampleString, UpdateSourceTrigger=PropertyChanged}" CueText="Text here..." Margin="10,36,0,0" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" Width="185"/>

		<Label Content="Sample Integer:" Margin="200,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
		<controls:CueTextBox Text="{Binding SampleInteger, UpdateSourceTrigger=PropertyChanged}" CueText="Number here..." Margin="200,36,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="103"/>
		
		<Button Content="_Save" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="10,59,0,0" VerticalAlignment="Top"/>
	</Grid>
</UserControl>
